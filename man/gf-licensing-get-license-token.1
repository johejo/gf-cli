.nh
.TH "GF-LICENSING-GET-LICENSE-TOKEN" "1" "May 2026" "" ""

.SH NAME
gf-licensing-get-license-token - Gets license token


.SH SYNOPSIS
\fBgf licensing get-license-token [flags]\fP


.SH DESCRIPTION
Gets license token

.PP
You need to have a permission with action \fBlicensing:read\fR\&.

.PP
Response schema (GetLicenseTokenOK.Payload):
  account                       string
  anonymousRatio                number
  company                       string
  details_url                   string
  exp                           number
  iat                           number
  included_users                number
  iss                           string
  jti                           string
  lexp                          number
  lic_exp_warn_days             number
  lid                           string
  limit_by                      string
  max_concurrent_user_sessions  number
  nbf                           number
  prod                          array
  slug                          string
  status                        number
  sub                           string
  tok_exp_warn_days             number
  trial                         boolean
  trial_exp                     number
  update_days                   number
  usage_billing                 boolean


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-license-token

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-licensing(1)\fP
