.nh
.TH "GF-USERS-SEARCH-USERS-WITH-PAGING" "1" "May 2026" "" ""

.SH NAME
gf-users-search-users-with-paging - Gets users with paging


.SH SYNOPSIS
\fBgf users search-users-with-paging [flags]\fP


.SH DESCRIPTION
Gets users with paging

.PP
Response schema (SearchUsersWithPagingOK.Payload):
  page                   number
  perPage                number
  totalCount             number
  users                  array
  users[].authLabels     array
  users[].avatarUrl      string
  users[].created        string
  users[].email          string
  users[].id             number
  users[].isAdmin        boolean
  users[].isDisabled     boolean
  users[].isProvisioned  boolean
  users[].lastSeenAt     string
  users[].lastSeenAtAge  string
  users[].login          string
  users[].name           string
  users[].uid            string


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for search-users-with-paging

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


