.TH "GF-SERVICE-ACCOUNTS-CREATE-TOKEN" "1" "Jun 2026" "" ""

.SH NAME
gf-service-accounts-create-token - Creates new token adds a token to a service account


.SH SYNOPSIS
\fBgf service-accounts create-token [flags]\fP


.SH DESCRIPTION
Creates new token adds a token to a service account

.PP
Required permissions (See note in the introduction
\[la]https://grafana.com/docs/grafana/latest/developers/http_api/serviceaccount/#service\-account\-api\[ra] for an explanation): action: \fBserviceaccounts:write\fR scope: \fBserviceaccounts:id:1\fR (single service account)

.PP
Body schema (AddServiceAccountTokenCommand):
  name           string
  secondsToLive  number

.PP
Response schema (CreateTokenOK.Payload):
  id    number
  key   string
  name  string


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create-token

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--service-account-id\fP=0
	ServiceAccountID [required]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


