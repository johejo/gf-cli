.TH "GF-SIGNED-IN-USER-REVOKE-USER-AUTH-TOKEN" "1" "Apr 2026" "" ""

.SH NAME
gf-signed-in-user-revoke-user-auth-token - Revokes an auth token of the actual user


.SH SYNOPSIS
\fBgf signed-in-user revoke-user-auth-token [flags]\fP


.SH DESCRIPTION
Revokes an auth token of the actual user

.PP
Revokes the given auth token (device) for the actual user. User of issued auth token (device) will no longer be logged in and will be required to authenticate again upon next activity.

.PP
Body schema (RevokeAuthTokenCmd):
{
  "authTokenId": number
}


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for revoke-user-auth-token


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-signed-in-user(1)\fP
