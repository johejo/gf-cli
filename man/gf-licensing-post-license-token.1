.nh
.TH "GF-LICENSING-POST-LICENSE-TOKEN" "1" "May 2026" "" ""

.SH NAME
gf-licensing-post-license-token - Creates license token


.SH SYNOPSIS
\fBgf licensing post-license-token [flags]\fP


.SH DESCRIPTION
Creates license token

.PP
You need to have a permission with action \fBlicensing:write\fR\&.

.PP
Body schema (DeleteTokenCommand):
  instance  string

.PP
Response schema (PostLicenseTokenOK.Payload):
  account                       string
  anonymousRatio                number
  company                       string
  details_url                   string
  exp                           number
  iat                           number
  included_users                number
  iss                           string
  jti                           string
  lexp                          number
  lic_exp_warn_days             number
  lid                           string
  limit_by                      string
  max_concurrent_user_sessions  number
  nbf                           number
  prod                          array
  slug                          string
  status                        number
  sub                           string
  tok_exp_warn_days             number
  trial                         boolean
  trial_exp                     number
  update_days                   number
  usage_billing                 boolean


