.TH "GF-ADMIN-USERS-ADMIN-DELETE-USER" "1" "Apr 2026" "" ""

.SH NAME
gf-admin-users-admin-delete-user - Deletes global user


.SH SYNOPSIS
\fBgf admin-users admin-delete-user [flags]\fP


.SH DESCRIPTION
If you are running Grafana Enterprise and have Fine-grained access control enabled, you need to have a permission with action \fBusers:delete\fR and scope \fBglobal.users:*\fR\&.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for admin-delete-user

.PP
\fB--user-id\fP=0
	UserID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-admin-users(1)\fP
