.TH "GF-SIGNING-KEYS-RETRIEVE-JWKS" "1" "Apr 2026" "" ""

.SH NAME
gf-signing-keys-retrieve-jwks - Gets JSON web key set j w k s with all the keys that can be used to verify tokens public keys


.SH SYNOPSIS
\fBgf signing-keys retrieve-jwks [flags]\fP


.SH DESCRIPTION
Gets JSON web key set j w k s with all the keys that can be used to verify tokens public keys

.PP
Required permissions None


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for retrieve-jwks


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-signing-keys(1)\fP
