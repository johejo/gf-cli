.TH "GF-LICENSING-POST-RENEW-LICENSE-TOKEN" "1" "Jun 2026" "" ""

.SH NAME
gf-licensing-post-renew-license-token - Manuallies force license refresh


.SH SYNOPSIS
\fBgf licensing post-renew-license-token [flags]\fP


.SH DESCRIPTION
Manuallies force license refresh

.PP
Manually ask license issuer for a new token. Available in Grafana Enterprise v7.4+.

.PP
You need to have a permission with action \fBlicensing:write\fR\&.


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for post-renew-license-token

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-licensing(1)\fP
