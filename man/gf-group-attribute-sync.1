.TH "GF-GROUP-ATTRIBUTE-SYNC" "1" "Jun 2026" "" ""

.SH NAME
gf-group-attribute-sync - Group attribute sync API


.SH SYNOPSIS
\fBgf group-attribute-sync [flags]\fP


.SH DESCRIPTION
Group attribute sync API


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for group-attribute-sync


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf(1)\fP, \fBgf-group-attribute-sync-create-group-mappings(1)\fP, \fBgf-group-attribute-sync-delete-group-mappings(1)\fP, \fBgf-group-attribute-sync-get-group-roles(1)\fP, \fBgf-group-attribute-sync-get-mapped-groups(1)\fP, \fBgf-group-attribute-sync-update-group-mappings(1)\fP
