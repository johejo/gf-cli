.nh
.TH "GF-REPORTS-RENDER-REPORT-PD-FS" "1" "Jun 2026" "" ""

.SH NAME
gf-reports-render-report-pd-fs - Renders report for multiple dashboards


.SH SYNOPSIS
\fBgf reports render-report-pd-fs [flags]\fP


.SH DESCRIPTION
Renders report for multiple dashboards

.PP
Available to all users and with a valid license.


.SH OPTIONS
\fB--dashboards\fP=""
	Dashboards

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for render-report-pd-fs

.PP
\fB--include-tables\fP=""
	IncludeTables

.PP
\fB--layout\fP=""
	Layout

.PP
\fB--orientation\fP=""
	Orientation

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--scale-factor\fP=""
	ScaleFactor

.PP
\fB--title\fP=""
	Title


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-reports(1)\fP
