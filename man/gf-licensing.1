.nh
.TH "GF-LICENSING" "1" "Apr 2026" "" ""

.SH NAME
gf-licensing -


.SH SYNOPSIS
\fBgf licensing [flags]\fP


.SH DESCRIPTION

.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for licensing


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf(1)\fP, \fBgf-licensing-delete-license-token(1)\fP, \fBgf-licensing-get-custom-permissions-csv(1)\fP, \fBgf-licensing-get-custom-permissions-report(1)\fP, \fBgf-licensing-get-license-token(1)\fP, \fBgf-licensing-get-status(1)\fP, \fBgf-licensing-post-license-token(1)\fP, \fBgf-licensing-post-renew-license-token(1)\fP, \fBgf-licensing-refresh-license-stats(1)\fP
