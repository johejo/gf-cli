.TH "GF-DATASOURCES-UPDATE-CORRELATION" "1" "Apr 2026" "" ""

.SH NAME
gf-datasources-update-correlation -


.SH SYNOPSIS
\fBgf datasources update-correlation [flags]\fP


.SH DESCRIPTION
Body schema (UpdateCorrelationCommand):
{
  "config": {
    "field": string,
    "target": any,
    "transformations": [object]  // []models.Transformation
  },
  "description": string,
  "label": string,
  "type": string
}
  config.field             Field used to attach the correlation link
  config.target            Target data query
  config.transformations   Source data transformations
  description              Optional description of the correlation
  label                    Optional label identifying the correlation


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block is a type reference; use --describe-body-jsonschema for a strict JSON Schema.

.PP
\fB--correlation-uid\fP=""
	CorrelationUID

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update-correlation

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--source-uid\fP=""
	SourceUID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-datasources(1)\fP
