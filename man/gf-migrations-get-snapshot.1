.nh
.TH "GF-MIGRATIONS-GET-SNAPSHOT" "1" "Jun 2026" "" ""

.SH NAME
gf-migrations-get-snapshot - Gets metadata about a snapshot including where it is in its processing and final results


.SH SYNOPSIS
\fBgf migrations get-snapshot [flags]\fP


.SH DESCRIPTION
Gets metadata about a snapshot including where it is in its processing and final results

.PP
Response schema (GetSnapshotOK.Payload):
  created               string
  finished              string
  results               array
  results[].errorCode   string               enum: ALERT_RULES_QUOTA_REACHED | ALERT_RULES_GROUP_QUOTA_REACHED | DATASOURCE_NAME_CONFLICT | DATASOURCE_INVALID_URL | DATASOURCE_ALREADY_MANAGED | FOLDER_NAME_CONFLICT | DASHBOARD_ALREADY_MANAGED | LIBRARY_ELEMENT_NAME_CONFLICT | UNSUPPORTED_DATA_TYPE | RESOURCE_CONFLICT | UNEXPECTED_STATUS_CODE | INTERNAL_SERVICE_ERROR | GENERIC_ERROR
  results[].message     string
  results[].name        string
  results[].parentName  string
  results[].refId       string               REQUIRED
  results[].status      string               REQUIRED
                                             enum: OK | WARNING | ERROR | PENDING | UNKNOWN
  results[].type        string               REQUIRED
                                             enum: DASHBOARD | DATASOURCE | FOLDER | LIBRARY_ELEMENT | ALERT_RULE | ALERT_RULE_GROUP | CONTACT_POINT | NOTIFICATION_POLICY | NOTIFICATION_TEMPLATE | MUTE_TIMING | PLUGIN
  sessionUid            string
  stats                 object
  stats.statuses        map
  stats.total           number
  stats.types           map
  status                string               enum: INITIALIZING | CREATING | PENDING_UPLOAD | UPLOADING | PENDING_PROCESSING | PROCESSING | FINISHED | CANCELED | ERROR | UNKNOWN
  uid                   string


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB--errors-only\fP[=false]
	ErrorsOnly is used to only return resources with error statuses

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-snapshot

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--result-limit\fP=100
	Max limit for snapshot results returned.

.PP
\fB--result-page\fP=1
	ResultPage is used for pagination with ResultLimit

.PP
\fB--result-sort-column\fP="default"
	ResultSortColumn can be used to override the default system sort. Valid values are "name", "resource_type", and "status".

.PP
\fB--result-sort-order\fP="ASC"
	ResultSortOrder is used with ResultSortColumn. Valid values are ASC and DESC.

.PP
\fB--snapshot-uid\fP=""
	UID of a snapshot [required]

.PP
\fB--uid\fP=""
	Session UID of a session [required]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-migrations(1)\fP
