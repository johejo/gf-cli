.TH "GF-REPORTS" "1" "Jun 2026" "" ""

.SH NAME
gf-reports - Reports API


.SH SYNOPSIS
\fBgf reports [flags]\fP


.SH DESCRIPTION
Reports API


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for reports


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf(1)\fP, \fBgf-reports-create-report(1)\fP, \fBgf-reports-delete-report(1)\fP, \fBgf-reports-get-report(1)\fP, \fBgf-reports-get-report-settings(1)\fP, \fBgf-reports-get-reports(1)\fP, \fBgf-reports-get-reports-by-dashboard-uid(1)\fP, \fBgf-reports-get-settings-image(1)\fP, \fBgf-reports-render-report-cs-vs(1)\fP, \fBgf-reports-render-report-pd-fs(1)\fP, \fBgf-reports-save-report-settings(1)\fP, \fBgf-reports-send-report(1)\fP, \fBgf-reports-send-test-email(1)\fP, \fBgf-reports-update-report(1)\fP
