.nh
.TH "GF-PROVISIONING-PUT-CONTACTPOINT" "1" "Apr 2026" "" ""

.SH NAME
gf-provisioning-put-contactpoint -


.SH SYNOPSIS
\fBgf provisioning put-contactpoint [flags]\fP


.SH DESCRIPTION
Body schema (EmbeddedContactPoint):
{
  "disableResolveMessage": boolean,
  "name": string,
  "provenance": string,
  "settings": any,
  "type": string,
  "uid": string
}
  settings                 required
  type                     required, enum: alertmanager | dingding | discord | email | googlechat | kafka | line | opsgenie | pagerduty | pushover | sensugo | slack | teams | telegram | threema | victorops | webhook | wecom


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for put-contactpoint

.PP
\fB--uid\fP=""
	UID is the contact point unique identifier

.PP
\fB--x-disable-provenance\fP=""
	XDisableProvenance


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-provisioning(1)\fP
