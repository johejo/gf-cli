.nh
.TH "GF-FOLDERS-GET-FOLDERS" "1" "May 2026" "" ""

.SH NAME
gf-folders-get-folders - Gets all folders


.SH SYNOPSIS
\fBgf folders get-folders [flags]\fP


.SH DESCRIPTION
Gets all folders

.PP
It returns all folders that the authenticated user has permission to view. If nested folders are enabled, it expects an additional query parameter with the parent folder UID and returns the immediate subfolders that the authenticated user has permission to view. If the parameter is not supplied then it returns immediate subfolders under the root that the authenticated user has permission to view.


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-folders

.PP
\fB--limit\fP=0
	Limit the maximum number of folders to return Default: 1000

.PP
\fB--page\fP=0
	Page index for starting fetching folders Default: 1

.PP
\fB--parent-uid\fP=""
	The parent folder UID

.PP
\fB--permission\fP=""
	Set to \fBEdit\fR to return folders that the user can edit Default: "View"

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-folders(1)\fP
