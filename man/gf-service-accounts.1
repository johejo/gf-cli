.TH "GF-SERVICE-ACCOUNTS" "1" "Apr 2026" "" ""

.SH NAME
gf-service-accounts - Service accounts API


.SH SYNOPSIS
\fBgf service-accounts [flags]\fP


.SH DESCRIPTION
Service accounts API


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for service-accounts


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf(1)\fP, \fBgf-service-accounts-create-service-account(1)\fP, \fBgf-service-accounts-create-token(1)\fP, \fBgf-service-accounts-delete-service-account(1)\fP, \fBgf-service-accounts-delete-token(1)\fP, \fBgf-service-accounts-list-tokens(1)\fP, \fBgf-service-accounts-retrieve-service-account(1)\fP, \fBgf-service-accounts-search-org-service-accounts-with-paging(1)\fP, \fBgf-service-accounts-update-service-account(1)\fP
