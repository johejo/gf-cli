.nh
.TH "GF-FOLDERS-GET-FOLDER-BY-UID" "1" "Jun 2026" "" ""

.SH NAME
gf-folders-get-folder-by-uid - Gets folder by uid


.SH SYNOPSIS
\fBgf folders get-folder-by-uid [flags]\fP


.SH DESCRIPTION
Gets folder by uid

.PP
Use: /apis/folder.grafana.app/v1/namespaces/{ns}/folders/{folder_uid}

.PP
Response schema (GetFolderByUIDOK.Payload):
  accessControl  map
  canAdmin       boolean
  canDelete      boolean
  canEdit        boolean
  canSave        boolean
  created        string
  createdBy      string
  hasAcl         boolean
  id             number                Deprecated: use UID instead
  managedBy      string
  orgId          number
  parentUid      string                only used if nested folders are enabled
  parents        array         the parent folders starting from the root going down
  title          string
  uid            string
  updated        string
  updatedBy      string
  url            string
  version        number


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB--folder-uid\fP=""
	FolderUID [required]

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-folder-by-uid

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-folders(1)\fP
