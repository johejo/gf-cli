.TH "GF-DASHBOARDS-IMPORT-DASHBOARD" "1" "May 2026" "" ""

.SH NAME
gf-dashboards-import-dashboard - Imports dashboard


.SH SYNOPSIS
\fBgf dashboards import-dashboard [flags]\fP


.SH DESCRIPTION
Imports dashboard

.PP
Body schema (ImportDashboardRequest):
  dashboard          object
  folderId           number         Deprecated: use FolderUID instead
  folderUid          string
  inputs             array
  inputs[].name      string
  inputs[].pluginId  string
  inputs[].type      string
  inputs[].value     string
  overwrite          boolean
  path               string
  pluginId           string

.PP
Response schema (ImportDashboardOK.Payload):
  dashboardId       number
  description       string
  folderId          number   Deprecated: use FolderUID instead
  folderUid         string
  imported          boolean
  importedRevision  number
  importedUri       string
  importedUrl       string
  path              string
  pluginId          string
  removed           boolean
  revision          number
  slug              string
  title             string
  uid               string


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema.

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for import-dashboard

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


