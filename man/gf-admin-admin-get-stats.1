.nh
.TH "GF-ADMIN-ADMIN-GET-STATS" "1" "Jun 2026" "" ""

.SH NAME
gf-admin-admin-get-stats - Fetches grafana stats


.SH SYNOPSIS
\fBgf admin admin-get-stats [flags]\fP


.SH DESCRIPTION
Fetches grafana stats

.PP
Only works with Basic Authentication (username and password). See introduction for an explanation. If you are running Grafana Enterprise and have Fine-grained access control enabled, you need to have a permission with action \fBserver:stats:read\fR\&.

.PP
Response schema (AdminGetStatsOK.Payload):
  activeAdmins         number
  activeDevices        number
  activeEditors        number
  activeSessions       number
  activeUsers          number
  activeViewers        number
  admins               number
  alerts               number
  dailyActiveAdmins    number
  dailyActiveEditors   number
  dailyActiveSessions  number
  dailyActiveUsers     number
  dailyActiveViewers   number
  dashboards           number
  datasources          number
  editors              number
  monthlyActiveUsers   number
  orgs                 number
  playlists            number
  snapshots            number
  stars                number
  tags                 number
  users                number
  viewers              number


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for admin-get-stats

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-admin(1)\fP
