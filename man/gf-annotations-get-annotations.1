.nh
.TH "GF-ANNOTATIONS-GET-ANNOTATIONS" "1" "Apr 2026" "" ""

.SH NAME
gf-annotations-get-annotations -


.SH SYNOPSIS
\fBgf annotations get-annotations [flags]\fP


.SH DESCRIPTION

.SH OPTIONS
\fB--alert-id\fP=0
	Find annotations for a specified alert rule by its ID. deprecated: AlertID is deprecated and will be removed in future versions. Please use AlertUID instead.

.PP
\fB--alert-uid\fP=""
	Find annotations for a specified alert rule by its UID.

.PP
\fB--dashboard-id\fP=0
	Find annotations that are scoped to a specific dashboard

.PP
\fB--dashboard-uid\fP=""
	Find annotations that are scoped to a specific dashboard

.PP
\fB--from\fP=0
	Find annotations created after specific epoch datetime in milliseconds.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-annotations

.PP
\fB--limit\fP=0
	Max limit for results returned.

.PP
\fB--match-any\fP[=false]
	Match any or all tags

.PP
\fB--panel-id\fP=0
	Find annotations that are scoped to a specific panel

.PP
\fB--tags\fP=[]
	Use this to filter organization annotations. Organization annotations are annotations from an annotation data source that are not connected specifically to a dashboard or panel. You can filter by multiple tags.

.PP
\fB--to\fP=0
	Find annotations created before specific epoch datetime in milliseconds.

.PP
\fB--type\fP=""
	Return alerts or user created annotations

.PP
\fB--user-id\fP=0
	Limit response to annotations created by specific user.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-annotations(1)\fP
