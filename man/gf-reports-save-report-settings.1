.nh
.TH "GF-REPORTS-SAVE-REPORT-SETTINGS" "1" "May 2026" "" ""

.SH NAME
gf-reports-save-report-settings - Saves settings


.SH SYNOPSIS
\fBgf reports save-report-settings [flags]\fP


.SH DESCRIPTION
Saves settings

.PP
Available to org admins only and with a valid or expired license.

.PP
You need to have a permission with action \fBreports.settings:write\fRxx.

.PP
Body schema (ReportSettings):
  branding                  object
  branding.emailFooterLink  string
  branding.emailFooterMode  string
  branding.emailFooterText  string
  branding.emailLogoUrl     string
  branding.reportLogoUrl    string
  embeddedImageTheme        string
  footerFontFamily          string
  footerItems               array
  footerItems[].color       string
  footerItems[].fontSize    string
  footerItems[].fontStyle   string
  footerItems[].fontWeight  string
  footerItems[].type        string
  footerItems[].value       string
  id                        number
  orgId                     number
  pdfDashboardTitleEnabled  boolean
  pdfHeaderEnabled          boolean
  pdfTheme                  string
  pdfTimeRangeEnabled       boolean
  userId                    number

.PP
Response schema (SaveReportSettingsOK.Payload):
  message  string


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for save-report-settings

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


