.nh
.TH "GF-FOLDERS-DELETE-FOLDER" "1" "May 2026" "" ""

.SH NAME
gf-folders-delete-folder - Deletes folder


.SH SYNOPSIS
\fBgf folders delete-folder [flags]\fP


.SH DESCRIPTION
Deletes folder

.PP
Deletes an existing folder identified by UID along with all dashboards (and their alerts) stored in the folder. This operation cannot be reverted. If nested folders are enabled then it also deletes all the subfolders.


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB--folder-uid\fP=""
	FolderUID

.PP
\fB--force-delete-rules\fP[=false]
	If \fBtrue\fR any Grafana 8 Alerts under this folder will be deleted. Set to \fBfalse\fR so that the request will fail if the folder contains any Grafana 8 Alerts.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for delete-folder

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-folders(1)\fP
