.TH "GF-DASHBOARDS-GET-DASHBOARD-PERMISSIONS-LIST-BY-UID" "1" "Apr 2026" "" ""

.SH NAME
gf-dashboards-get-dashboard-permissions-list-by-uid - Gets all existing permissions for the given dashboard


.SH SYNOPSIS
\fBgf dashboards get-dashboard-permissions-list-by-uid [flags]\fP


.SH DESCRIPTION
Gets all existing permissions for the given dashboard


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for get-dashboard-permissions-list-by-uid

.PP
\fB--uid\fP=""
	UID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-dashboards(1)\fP
