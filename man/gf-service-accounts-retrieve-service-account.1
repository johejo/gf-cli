.TH "GF-SERVICE-ACCOUNTS-RETRIEVE-SERVICE-ACCOUNT" "1" "May 2026" "" ""

.SH NAME
gf-service-accounts-retrieve-service-account - Gets single serviceaccount by Id


.SH SYNOPSIS
\fBgf service-accounts retrieve-service-account [flags]\fP


.SH DESCRIPTION
Gets single serviceaccount by Id

.PP
Required permissions (See note in the introduction
\[la]https://grafana.com/docs/grafana/latest/developers/http_api/serviceaccount/#service\-account\-api\[ra] for an explanation): action: \fBserviceaccounts:read\fR scope: \fBserviceaccounts:id:1\fR (single service account)


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for retrieve-service-account

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--service-account-id\fP=0
	ServiceAccountID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-service-accounts(1)\fP
