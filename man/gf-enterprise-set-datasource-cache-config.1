.TH "GF-ENTERPRISE-SET-DATASOURCE-CACHE-CONFIG" "1" "Apr 2026" "" ""

.SH NAME
gf-enterprise-set-datasource-cache-config - Set cache config for a single data source


.SH SYNOPSIS
\fBgf enterprise set-datasource-cache-config [flags]\fP


.SH DESCRIPTION
Set cache config for a single data source

.PP
Body schema (CacheConfigSetter):
{
  "dataSourceID": number,
  "dataSourceUID": string,
  "enabled": boolean,
  "ttlQueriesMs": number,
  "ttlResourcesMs": number,
  "useDefaultTTL": boolean
}
  ttlQueriesMs             TTL MS, or "time to live", is how long a cached item will stay in the cache before it is removed (in milliseconds)
  useDefaultTTL            If UseDefaultTTL is enabled, then the TTLQueriesMS and TTLResourcesMS in this object is always sent as the default TTL located in grafana.ini


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB--data-source-uid\fP=""
	DataSourceUID

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set-datasource-cache-config


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-enterprise(1)\fP
