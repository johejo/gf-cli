.nh
.TH "GF-ACCESS-CONTROL-GET-RESOURCE-DESCRIPTION" "1" "May 2026" "" ""

.SH NAME
gf-access-control-get-resource-description - Gets a description of a resource s access control properties


.SH SYNOPSIS
\fBgf access-control get-resource-description [flags]\fP


.SH DESCRIPTION
Gets a description of a resource s access control properties

.PP
Response schema (GetResourceDescriptionOK.Payload):
  assignments                  object
  assignments.builtInRoles     boolean
  assignments.serviceAccounts  boolean
  assignments.teams            boolean
  assignments.users            boolean
  permissions                  array


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-resource-description

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--resource\fP=""
	Resource [required]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-access-control(1)\fP
