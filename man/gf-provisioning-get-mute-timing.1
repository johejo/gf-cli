.nh
.TH "GF-PROVISIONING-GET-MUTE-TIMING" "1" "May 2026" "" ""

.SH NAME
gf-provisioning-get-mute-timing - Gets a mute timing


.SH SYNOPSIS
\fBgf provisioning get-mute-timing [flags]\fP


.SH DESCRIPTION
Gets a mute timing

.PP
Response schema (GetMuteTimingOK.Payload):
  name                                 string
  time_intervals                       array
  time_intervals[].days_of_month       array
  time_intervals[].location            string
  time_intervals[].months              array
  time_intervals[].times               array
  time_intervals[].times[].end_time    string
  time_intervals[].times[].start_time  string
  time_intervals[].weekdays            array
  time_intervals[].years               array


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-mute-timing

.PP
\fB--name\fP=""
	Mute timing name [required]

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-provisioning(1)\fP
