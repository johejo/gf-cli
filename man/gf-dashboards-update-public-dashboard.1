.TH "GF-DASHBOARDS-UPDATE-PUBLIC-DASHBOARD" "1" "May 2026" "" ""

.SH NAME
gf-dashboards-update-public-dashboard - Update public dashboard for a dashboard


.SH SYNOPSIS
\fBgf dashboards update-public-dashboard [flags]\fP


.SH DESCRIPTION
Update public dashboard for a dashboard

.PP
Body schema (PublicDashboardDTO):
  accessToken           string
  annotationsEnabled    boolean
  isEnabled             boolean
  share                 string
  timeSelectionEnabled  boolean
  uid                   string

.PP
Response schema (UpdatePublicDashboardOK.Payload):
  accessToken             string
  annotationsEnabled      boolean
  createdAt               string
  createdBy               number
  dashboardUid            string
  isEnabled               boolean
  recipients              array
  recipients[].recipient  string
  recipients[].uid        string
  share                   string
  timeSelectionEnabled    boolean
  uid                     string
  updatedAt               string
  updatedBy               number


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block above lists fields and types; use --describe-body-jsonschema for a strict JSON Schema.

.PP
\fB--dashboard-uid\fP=""
	DashboardUID

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update-public-dashboard

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--uid\fP=""
	UID


