.TH "GF-PROVISIONING-PUT-POLICY-TREE" "1" "May 2026" "" ""

.SH NAME
gf-provisioning-put-policy-tree - Sets the notification policy tree


.SH SYNOPSIS
\fBgf provisioning put-policy-tree [flags]\fP


.SH DESCRIPTION
Sets the notification policy tree

.PP
Body schema (Route):
  active_time_intervals  array
  continue               boolean
  group_by               array
  group_interval         string
  group_wait             string
  match                  map   Deprecated. Remove before v1.0 release.
  match_re               map
  matchers               array
  matchers[].Name        string
  matchers[].Type        number
  matchers[].Value       string
  mute_time_intervals    array
  object_matchers        array>
  provenance             string
  receiver               string
  repeat_interval        string
  routes                 array


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for put-policy-tree

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--x-disable-provenance\fP=""
	XDisableProvenance


