.TH "GF-MIGRATIONS-GET-SHAPSHOT-LIST" "1" "Jun 2026" "" ""

.SH NAME
gf-migrations-get-shapshot-list - Gets a list of snapshots for a session


.SH SYNOPSIS
\fBgf migrations get-shapshot-list [flags]\fP


.SH DESCRIPTION
Gets a list of snapshots for a session

.PP
Response schema (GetShapshotListOK.Payload):
  snapshots               array
  snapshots[].created     string
  snapshots[].finished    string
  snapshots[].sessionUid  string
  snapshots[].status      string         enum: INITIALIZING | CREATING | PENDING_UPLOAD | UPLOADING | PENDING_PROCESSING | PROCESSING | FINISHED | CANCELED | ERROR | UNKNOWN
  snapshots[].uid         string


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-shapshot-list

.PP
\fB--limit\fP=100
	Max limit for results returned.

.PP
\fB--page\fP=1
	Page is used for pagination with limit

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--sort\fP=""
	Sort with value latest to return results sorted in descending order.

.PP
\fB--uid\fP=""
	Session UID of a session [required]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-migrations(1)\fP
