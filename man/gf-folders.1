.nh
.TH "GF-FOLDERS" "1" "Jun 2026" "" ""

.SH NAME
gf-folders - Folders API


.SH SYNOPSIS
\fBgf folders [flags]\fP


.SH DESCRIPTION
Folders API


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for folders


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf(1)\fP, \fBgf-folders-create-folder(1)\fP, \fBgf-folders-delete-folder(1)\fP, \fBgf-folders-get-folder-by-uid(1)\fP, \fBgf-folders-get-folder-descendant-counts(1)\fP, \fBgf-folders-get-folder-permission-list(1)\fP, \fBgf-folders-get-folders(1)\fP, \fBgf-folders-move-folder(1)\fP, \fBgf-folders-update-folder(1)\fP, \fBgf-folders-update-folder-permissions(1)\fP
