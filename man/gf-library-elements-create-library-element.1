.TH "GF-LIBRARY-ELEMENTS-CREATE-LIBRARY-ELEMENT" "1" "Apr 2026" "" ""

.SH NAME
gf-library-elements-create-library-element - Creates library element


.SH SYNOPSIS
\fBgf library-elements create-library-element [flags]\fP


.SH DESCRIPTION
Creates library element

.PP
Creates a new library element.

.PP
Body schema (CreateLibraryElementCommand):
{
  "folderId": number,
  "folderUid": string,
  "kind": number,
  "model": any,
  "name": string,
  "uid": string
}
  folderId                 ID of the folder where the library element is stored. Deprecated: use FolderUID instead
  folderUid                UID of the folder where the library element is stored.
  kind                     Kind of element to create, Use 1 for library panels or 2 for c. Description: 1 - library panels, enum: 1
  model                    The JSON model for the library element.
  name                     Name of the library element.


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create-library-element


