.TH "GF-FOLDERS-MOVE-FOLDER" "1" "Jun 2026" "" ""

.SH NAME
gf-folders-move-folder - Moves folder


.SH SYNOPSIS
\fBgf folders move-folder [flags]\fP


.SH DESCRIPTION
Moves folder

.PP
Use: /apis/folder.grafana.app/v1/namespaces/{ns}/folders/{folder_uid}, Changing the parent folder annotation

.PP
Body schema (MoveFolderCommand):
  parentUid  string

.PP
Response schema (MoveFolderOK.Payload):
  accessControl  map
  canAdmin       boolean
  canDelete      boolean
  canEdit        boolean
  canSave        boolean
  created        string
  createdBy      string
  hasAcl         boolean
  id             number                Deprecated: use UID instead
  managedBy      string
  orgId          number
  parentUid      string                only used if nested folders are enabled
  parents        array         the parent folders starting from the root going down
  title          string
  uid            string
  updated        string
  updatedBy      string
  url            string
  version        number


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
