.nh
.TH "GF-PROVISIONING-PUT-ALERT-RULE" "1" "Apr 2026" "" ""

.SH NAME
gf-provisioning-put-alert-rule -


.SH SYNOPSIS
\fBgf provisioning put-alert-rule [flags]\fP


.SH DESCRIPTION
Body schema (ProvisionedAlertRule):
{
  "annotations": {"key": string},
  "condition": string,
  "data": [
    {
      "datasourceUid": string,
      "model": any,
      "queryType": string,
      "refId": string,
      "relativeTimeRange": object
    }
  ],
  "execErrState": string,
  "folderUID": string,
  "for": string,
  "id": number,
  "isPaused": boolean,
  "keep_firing_for": string,
  "labels": {"key": string},
  "missingSeriesEvalsToResolve": number,
  "noDataState": string,
  "notification_settings": {
    "active_time_intervals": [string],
    "group_by": [string],
    "group_interval": string,
    "group_wait": string,
    "mute_time_intervals": [string],
    "receiver": string,
    "repeat_interval": string
  },
  "orgID": number,
  "provenance": string,
  "record": {
    "from": string,
    "metric": string,
    "target_datasource_uid": string
  },
  "ruleGroup": string,
  "title": string,
  "uid": string,
  "updated": string
}
  condition                required
  data                     required
  execErrState             required, enum: OK | Alerting | Error
  folderUID                required
  for                      required
  noDataState              required, enum: Alerting | NoData | OK
  notification_settings.receiver required
  orgID                    required
  record.from              required
  record.metric            required
  ruleGroup                required
  title                    required


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for put-alert-rule

.PP
\fB--uid\fP=""
	Alert rule UID

.PP
\fB--x-disable-provenance\fP=""
	XDisableProvenance


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-provisioning(1)\fP
