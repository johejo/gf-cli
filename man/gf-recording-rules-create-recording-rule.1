.TH "GF-RECORDING-RULES-CREATE-RECORDING-RULE" "1" "Apr 2026" "" ""

.SH NAME
gf-recording-rules-create-recording-rule - Creates a recording rule that is then registered and started


.SH SYNOPSIS
\fBgf recording-rules create-recording-rule [flags]\fP


.SH DESCRIPTION
Body schema (RecordingRuleJSON):
{
  "active": boolean,
  "count": boolean,
  "description": string,
  "dest_data_source_uid": string,
  "id": string,
  "interval": number,
  "name": string,
  "prom_name": string,
  "queries": [any],
  "range": number,
  "target_ref_id": string
}


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create-recording-rule


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-recording-rules(1)\fP
