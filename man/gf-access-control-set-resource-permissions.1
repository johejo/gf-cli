.TH "GF-ACCESS-CONTROL-SET-RESOURCE-PERMISSIONS" "1" "Jun 2026" "" ""

.SH NAME
gf-access-control-set-resource-permissions - Sets resource permissions


.SH SYNOPSIS
\fBgf access-control set-resource-permissions [flags]\fP


.SH DESCRIPTION
Sets resource permissions

.PP
Assigns permissions for a resource by a given type (\fB:resource\fR) and \fB:resourceID\fR to one or many assignment types. Allowed resources are \fBdatasources\fR, \fBteams\fR, \fBdashboards\fR, \fBfolders\fR, and \fBserviceaccounts\fR\&. Refer to the \fB/access-control/{resource}/description\fR endpoint for allowed Permissions.

.PP
Body schema (SetPermissionsCommand):
  permissions                array
  permissions[].builtInRole  string
  permissions[].permission   string
  permissions[].teamId       number
  permissions[].userId       number

.PP
Response schema (SetResourcePermissionsOK.Payload):
  message  string


.SH OPTIONS
\fB--body\fP=""
	Request body JSON or path to a JSON file (e.g. --body=/path/to/body.json, --body='{"foo": "bar"}'). The 'Body schema' block below lists fields and types; use --describe-body-jsonschema for a strict JSON Schema. [required]

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set-resource-permissions

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--resource\fP=""
	Resource [required]

.PP
\fB--resource-id\fP=""
	ResourceID [required]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

