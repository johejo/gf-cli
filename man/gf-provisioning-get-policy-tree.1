.nh
.TH "GF-PROVISIONING-GET-POLICY-TREE" "1" "Jun 2026" "" ""

.SH NAME
gf-provisioning-get-policy-tree - Gets the notification policy tree


.SH SYNOPSIS
\fBgf provisioning get-policy-tree [flags]\fP


.SH DESCRIPTION
Gets the notification policy tree

.PP
Response schema (GetPolicyTreeOK.Payload):
  active_time_intervals  array
  continue               boolean
  group_by               array
  group_interval         string
  group_wait             string
  match                  map   Deprecated. Remove before v1.0 release.
  match_re               map
  matchers               array
  matchers[].Name        string
  matchers[].Type        number
  matchers[].Value       string
  mute_time_intervals    array
  object_matchers        array>
  provenance             string
  receiver               string
  repeat_interval        string
  routes                 array


.SH OPTIONS
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get-policy-tree

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-provisioning(1)\fP
