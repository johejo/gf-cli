.TH "GF-ACCESS-CONTROL-LIST-ROLES" "1" "Jun 2026" "" ""

.SH NAME
gf-access-control-list-roles - Gets all roles


.SH SYNOPSIS
\fBgf access-control list-roles [flags]\fP


.SH DESCRIPTION
Gets all roles

.PP
Gets all existing roles. The response contains all global and organization local roles, for the organization which user is signed in.

.PP
You need to have a permission with action \fBroles:read\fR and scope \fBroles:*\fR\&.

.PP
The \fBdelegatable\fR flag reduces the set of roles to only those for which the signed-in user has permissions to assign.


.SH OPTIONS
\fB--delegatable\fP[=false]
	Delegatable

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list-roles

.PP
\fB--include-hidden\fP[=false]
	IncludeHidden

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--target-org-id\fP=0
	TargetOrgID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using server behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)

.PP
\fB--timeout\fP=30s
	Timeout for the HTTP request to the Grafana server; 0 disables it (env: GF_TIMEOUT)


.SH SEE ALSO
\fBgf-access-control(1)\fP
