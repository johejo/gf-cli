.nh
.TH "GF-ENTERPRISE-ENABLE-DATASOURCE-CACHE" "1" "May 2026" "" ""

.SH NAME
gf-enterprise-enable-datasource-cache - Enable cache for a single data source


.SH SYNOPSIS
\fBgf enterprise enable-datasource-cache [flags]\fP


.SH DESCRIPTION
Enable cache for a single data source

.PP
Response schema (EnableDataSourceCacheOK.Payload):
  created         string
  dataSourceID    number   Fields that can be set by the API caller - read/write
  dataSourceUID   string
  defaultTTLMs    number   These are returned by the HTTP API, but are managed internally - read-only
                           Note: 'created' and 'updated' are special properties managed automatically by xorm, but we are setting them manually
  enabled         boolean
  message         string
  ttlQueriesMs    number   TTL MS, or "time to live", is how long a cached item will stay in the cache before it is removed (in milliseconds)
  ttlResourcesMs  number
  updated         string
  useDefaultTTL   boolean  If UseDefaultTTL is enabled, then the TTLQueriesMS and TTLResourcesMS in this object is always sent as the default TTL located in grafana.ini


.SH OPTIONS
\fB--data-source-uid\fP=""
	DataSourceUID

.PP
\fB--describe-response-jsonschema\fP[=false]
	Print the JSON Schema of the response payload and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for enable-datasource-cache

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-enterprise(1)\fP
