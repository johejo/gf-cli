.TH "GF-TEAMS-UPDATE-TEAM-PREFERENCES" "1" "Apr 2026" "" ""

.SH NAME
gf-teams-update-team-preferences - Updates team preferences


.SH SYNOPSIS
\fBgf teams update-team-preferences [flags]\fP


.SH DESCRIPTION
Updates team preferences

.PP
Body schema (UpdatePrefsCmd):
{
  "cookies": [string],
  "homeDashboardId": number,
  "homeDashboardUID": string,
  "language": string,
  "navbar": {
    "bookmarkUrls": [string]
  },
  "queryHistory": {
    "homeTab": string
  },
  "regionalFormat": string,
  "theme": string,
  "timezone": string,
  "weekStart": string
}
  homeDashboardId          The numerical :id of a favorited dashboard
  theme                    enum: light | dark | system
  timezone                 enum: utc | browser


.SH OPTIONS
\fB--body\fP=""
	The path to the body json file or json string. For example, --body=/path/to/body.json or --body='{"foo": "bar"}'

.PP
\fB--describe-body-jsonschema\fP[=false]
	Print the JSON Schema of the request body and exit without calling the API

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update-team-preferences

.PP
\fB--raw\fP[=false]
	Print the raw HTTP response body instead of the decoded payload

.PP
\fB--team-id\fP=""
	TeamID


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-teams(1)\fP
