.nh
.TH "GF-SEARCH-SEARCH" "1" "Apr 2026" "" ""

.SH NAME
gf-search-search -


.SH SYNOPSIS
\fBgf search search [flags]\fP


.SH DESCRIPTION

.SH OPTIONS
\fB--dashboard-ids\fP=[]
	List of dashboard id’s to search for This is deprecated: users should use the \fBdashboardUIDs\fR query parameter instead

.PP
\fB--dashboard-uids\fP=[]
	List of dashboard uid’s to search for

.PP
\fB--deleted\fP[=false]
	Flag indicating if only soft deleted Dashboards should be returned

.PP
\fB--folder-ids\fP=[]
	List of folder id’s to search in for dashboards If it's \fB0\fR then it will query for the top level folders This is deprecated: users should use the \fBfolderUIDs\fR query parameter instead

.PP
\fB--folder-uids\fP=[]
	List of folder UID’s to search in for dashboards If it's an empty string then it will query for the top level folders

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for search

.PP
\fB--limit\fP=0
	Limit the number of returned results (max 5000)

.PP
\fB--page\fP=0
	Use this parameter to access hits beyond limit. Numbering starts at 1. limit param acts as page size. Only available in Grafana v6.2+.

.PP
\fB--permission\fP=""
	Set to \fBEdit\fR to return dashboards/folders that the user can edit Default: "View"

.PP
\fB--query\fP=""
	Search Query

.PP
\fB--sort\fP=""
	Sort method; for listing all the possible sort methods use the search sorting endpoint. Default: "alpha-asc"

.PP
\fB--starred\fP[=false]
	Flag indicating if only starred Dashboards should be returned

.PP
\fB--tag\fP=[]
	List of tags to search for

.PP
\fB--type\fP=""
	Type to search for, dash-folder or dash-db


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API Key to authenticate to grafana server (env: GF_API_KEY)

.PP
\fB--base-path\fP="/api"
	Base path for server: useful when using sever behind reverse proxy (env: GF_BASE_PATH)

.PP
\fB--basic-user-password\fP=""
	Basic authentication password (env: GF_BASIC_AUTH_USERNAME)

.PP
\fB--basic-user-username\fP=""
	Basic authentication username (env: GF_BASIC_AUTH_PASSWORD)

.PP
\fB--debug\fP[=false]
	Enable debug logging (env: GF_DEBUG)

.PP
\fB--host\fP="localhost:3000"
	Grafana server host (env: GF_HOST)

.PP
\fB--org-id\fP=0
	Organization ID (env: GF_ORG_ID)


.SH SEE ALSO
\fBgf-search(1)\fP
